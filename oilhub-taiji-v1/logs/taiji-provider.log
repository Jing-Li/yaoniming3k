{"timestamp": "2026-05-14T02:09:42.995087+00:00", "level": "DEBUG", "logger": "raw_response", "message": "Outgoing response (streaming)", "request_id": "7a314062-39c1-4695-9a05-10f63b47ecd9", "total_chunks": 46, "chunks_preview": ["{\"id\":\"chatcmpl-00fe0a4a5215\",\"object\":\"chat.completion.chunk\",\"created\":1778724578,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"reasoning_content\":\" The\"}}]}", "{\"id\":\"chatcmpl-00fe0a4a5215\",\"object\":\"chat.completion.chunk\",\"created\":1778724578,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" issue\"}}]}", "{\"id\":\"chatcmpl-00fe0a4a5215\",\"object\":\"chat.completion.chunk\",\"created\":1778724578,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" is\"}}]}", "{\"id\":\"chatcmpl-00fe0a4a5215\",\"object\":\"chat.completion.chunk\",\"created\":1778724578,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" clearly\"}}]}", "{\"id\":\"chatcmpl-00fe0a4a5215\",\"object\":\"chat.completion.chunk\",\"created\":1778724578,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" that\"}}]}"]}
