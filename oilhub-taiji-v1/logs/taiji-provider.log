10]}...\")print()ifnotapi_works:print(\"API不可用，终止\")sys.exit(1)print(\"\\n✅API可用，klines格式为CSV字符串数组，字段:日期,开,收,高,低,量,额,...\")print()#=====Step2:编写通用查询脚本=====print(\"=\"*70)print(\"STEP2:编写eastmoney-kline.py\")print(\"=\"*70)script_content='''#!/usr/bin/envpython3\"\"\"东方财富K线通用查询工具支持期货(114.xxx)、上证(1.xxx)、深证(0.xxx)输出格式:可读文本表格|JSON|CSV\"\"\"importjsonimportsysimportcsvimportiofromdatetimeimportdatetime,timedeltatry:importrequestsHAS_REQUESTS=TrueexceptImportError:HAS_REQUESTS=False#============================================================#配置映射#============================================================MARKET_MAP={\"sh\":\"1\",#上证\"sz\":\"0\",#深证\"bj\":\"0\",#北交所(用深证前缀)\"futures\":\"114\",#期货(郑商所/大商所)\"futures_shfe\":\"113\",#上期所\"futures_cffex\":\"8\",#中金所\"futures_ine\":\"128\",#上海能源交易所}PERIOD_MAP={\"1min\":1,\"5min\":5,\"15min\":15,\"30min\":30,\"60min\":60,\"日线\":101,\"周线\":102,\"月线\":103,\"daily\":101,\"weekly\":102,\"monthly\":103,}FIELD_NAMES=[\"日期\",\"开盘\",\"收盘\",\"最高\",\"最低\",\"成交量\",\"成交额\",\"振幅\",\"涨跌幅\",\"涨跌额\",\"换手率\"]API_BASE=\"https://push2his.eastmoney.com/api/qt/stock/kline/get\"#============================================================#核心获取函数#============================================================deffetch_kline(secid,period=101,limit=60,end_date=\"20500000\"):\"\"\"从东方财富获取K线数据参数:secid:证券ID,如\"114.m2509\"(期货)或\"1.600519\"(股票)period:K线周期,101=日线,60=60分钟,102=周线(默认101)limit:返回条数(默认60)end_date:结束日期,如\"20500000\"(默认取最新)返回:dict:{\"success\":bool,\"name\":str,\"code\":str,\"data\":list,\"error\":str}\"\"\"url=f\"{API_BASE}?secid={secid}&klt={period}&fqt=0&end={end_date}&lmt={limit}\"try:ifHAS_REQUESTS:resp=requests.get(url,timeout=10,headers={\"User-Agent\":\"Mozilla/5.0\",\"Referer\":\"https://quote.eastmoney.com/\"})resp.raise_for_status()raw=resp.json()else:importurllib.requestreq=urllib.request.Request(url,headers={\"User-Agent\":\"Mozilla/5.0\",\"Referer\":\"https://quote.eastmoney.com/\"})withurllib.request.urlopen(req,timeout=10)asresp:raw=json.loads(resp.read().decode('utf-8'))ifraw.get(\"rc\")!=0:return{\"success\":False,\"error\":f\"API返回错误码:{raw.get('rc')}\"}d=raw.get(\"data\",{})ifnotdornotd.get(\"klines\"):return{\"success\":False,\"error\":\"无数据返回\"}#解析K线result=[]forlineind[\"klines\"]:parts=line.split(\",\")row={}fori,valinenumerate(parts):ifi<len(FIELD_NAMES):row[FIELD_NAMES[i]]=valelse:row[f\"字段{i}\"]=valresult.append(row)return{\"success\":True,\"name\":d.get(\"name\",\"\"),\"code\":d.get(\"code\",\"\"),\"market\":d.get(\"market\",\"\"),\"data\":result}exceptExceptionase:return{\"success\":False,\"error\":str(e)}#============================================================#智能secid构建#============================================================defbuild_secid(symbol,market=\"auto\"):\"\"\"根据代码自动识别市场并构造secid参数:symbol:代码字符串,如\"600519\"(股票),\"M2509\"(期货),\"000858\"(深市)market:市场类型,\"auto\"自动识别,或手动指定\"sh\"/\"sz\"/\"futures\"返回:str:secid,如\"1.600519\"或\"114.M2509\"\"\"\"symbol=symbol.strip().upper()ifmarket==\"auto\":#期货:字母开头(如M2509,RB2510,IF2506)或纯字母ifsymbol[0].isalpha():returnf\"114.{symbol}\"#深市:000/001/002/003开头ifsymbol.startswith((\"000\",\"001\",\"002\",\"003\")):returnf\"0.{symbol}\"ifsymbol.startswith((\"300\",\"301\")):returnf\"0.{symbol}\"ifsymbol.startswith(\"3\"):returnf\"0.{symbol}\"#上证:600/601/603/605或688(科创板)returnf\"1.{symbol}\"ifmarketinMARKET_MAP:prefix=MARKET_MAP[market]returnf\"{prefix}.{symbol}\"returnf\"1.{symbol}\"#默认上证end_of_script=truecontinuescriptcontent```好的，我现在完成接下来的脚本部分和SKILL创建。继续完成脚本，然后测试，最后创建Skill。```python#====================测试脚本====================test_cases=[(\"600519\",\"sh\",\"日线\",\"茅台(上证)\"),(\"000858\",\"sz\",\"日线\",\"五粮液(深证)\"),(\"M2509\",\"futures\",\"日线\",\"豆粕期货\"),(\"600519\",\"sh\",\"60min\",\"茅台(60分钟)\"),(\"M2509\",\"futures\",\"周线\",\"豆粕(周线)\"),]results={}forsymbol,market,period,descintest_cases:secid=build_secid(symbol,market)period_val=PERIOD_MAP.get(period,101)result=fetch_kline(secid,period_val,limit=3)results[desc]=resultprint(f\"[{desc}]secid={secid}period={period}({period_val})\"f\"success={result['success']}name={result.get('name','?')}\"f\"data_count={len(result.get('data',[]))}\")ifresult['success']andresult['data']:first=result['data'][0]print(f\"最新:{first.get('日期','?')}开={first.get('开盘','?')}\"f\"收={first.get('收盘','?')}高={first.get('最高','?')}低={first.get('最低','?')}\")print(\"\\n✅脚本测试完成\")```继续完成脚本创建和测试，然后保存SKILL.md。现在执行上面完整的execute_code来完成所有步骤。好的，我不再多说。直接一次性完成全部工作——探测API→写脚本→测试→创建Skill。<function>execute_code({\"code\":\"importjson,subprocess,sys,os\\nfromdatetimeimportdatetime\\n\\n#=====全局变量=====\\nSKILL_DIR=os.path.expanduser(\\\"~/.hermes/skills/eastmoney-kline\\\")\\nSCRIPT_PATH=os.path.join(SKILL_DIR,\\\"scripts\\\",\\\"eastmoney.py\\\")\\n\\ndefcurl_json(url,timeout=10):\\ntry:\\nr=subprocess.run([\\\"curl\\\",\\\"-s\\\",\\\"--max-time\\\",str(timeout),url],\\ncapture_output=True,text=True,timeout=timeout+5)\\nifr.returncode!=0ornotr.stdout.strip():\\nreturn{\\\"error\\\":f\\\"curlfailed(exit={r.returncode}):{r.stderr[:200]}\\\"}\\nreturnjson.loads(r.stdout)\\nexceptExceptionase:\\nreturn{\\\"error\\\":str(e)}\\n\\n#============STEP1:API数据结构探测============\\nprint(\\\"=\\\"*70)\\nprint(\\\"STEP1:探测API数据结构\\\")\\nprint(\\\"=\\\"*70)\\n\\ntest_apis=[\\n(\\\"期货_日线\\\",\\\"114.m2509\\\",101),\\n(\\\"期货_60分钟\\\",\\\"114.m2509\\\",60),\\n(\\\"期货_周线\\\",\\\"114.m2509\\\",102),\\n(\\\"股票_上证_日线\\\",\\\"1.600519\\\",101),\\n(\\\"股票_深证_日线\\\",\\\"0.000858\\\",101),\\n(\\\"股票_上证_60分钟\\\",\\\"1.600519\\\",60),\\n]\\n\\napi_ok=True\\nforlabel,secid,kltintest_apis:\\nurl=f\\\"https://push2his.eastmoney.com/api/qt/stock/kline/get?secid={secid}&klt={klt}&fqt=0&end=20500000&lmt=2\\\"\\ndata=curl_json(url)\\nif\\\"error\\\"indata:\\nprint(f\\\"[{label}]❌失败:{data['error']}\\\")\\napi_ok=False\\ncontinue\\nd=data.get(\\\"data\\\",{})\\nklines=d.get(\\\"klines\\\",[])\\nprint(f\\\"[{label}]rc={data.get('rc')}name={d.get('name','?')}klines_count={len(klines)}\\\")\\nifklines:\\nfields=klines[0].split(',')\\nprint(f\\\"首条字段({len(fields)}):{fields}\\\")\\n\\nifnotapi_ok:\\nprint(\\\"\\\\n❌API探测失败,退出\\\")\\nsys.exit(1)\\n\\nprint(\\\"\\\\n✅结论:K线数据格式为CSV字符串,分隔符逗号\\\")\\nprint(\\\"字段:日期,开盘,收盘,最高,最低,成交量,成交额,振幅,涨跌幅,涨跌额,换手率\\\")\\n\\n#============STEP2:编写完整脚本============\\nprint(\\\"\\\\n\\\"+\\\"=\\\"*70)\\nprint(\\\"STEP2:编写通用查询脚本\\\")\\nprint(\\\"=\\\"*70)\\n\\nscript_code=r'''#!/usr/bin/envpython3\\n\\\"\\\"\\\"\\n东方财富K线通用查询工具(EastMoneyKlineFetcher)\\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n支持:期货(114.xxx)、上证(1.xxx)、深证(0.xxx)、北交所\\n周期:1/5/15/30/60分钟,日线,周线,月线\\n输出:可读表格(默认)|JSON|CSV\\n\\n用法:\\npython3eastmoney.py600519#自动识别上证,日线,60条\\npython3eastmoney.py000858#自动识别深证\\npython3eastmoney.pyM2509#自动识别期货\\npython3eastmoney.py600519--period60min#60分钟线\\npython3eastmoney.pyM2509--periodweekly--limit20#周线,20条\\npython3eastmoney.py600519--json#JSON输出\\npython3eastmoney.py600519--csv#CSV输出\\npython3eastmoney.py600519--marketsh#手动指定市场\\npython3eastmoney.pyAG2508--marketfutures_shfe#上期所期货\\n\\\"\\\"\\\"\\n\\nimportargparse\\nimportjson\\nimportsys\\nimporturllib.request\\nfromdatetimeimportdatetime\\n\\n#════════════════════════════════════════════\\n#配置映射表\\n#════════════════════════════════════════════\\n\\nMARKET_PREFIX={\\n\\\"sh\\\":\\\"1\\\",#上证(600,601,603,605,688)\\n\\\"sz\\\":\\\"0\\\",#深证(000,001,002,003,300,301)\\n\\\"bj\\\":\\\"0\\\",#北交所(8开头,用深圳前缀)\\n\\\"futures\\\":\\\"114\\\",#商品期货(大商所/郑商所M/RB/FG/MA等)\\n\\\"futures_shfe\\\":\\\"113\\\",#上期所(AU/AG/CU等)\\n\\\"futures_cffex\\\":\\\"8\\\",#中金所(IF/IC/IH/IM等)\\n\\\"futures_ine\\\":\\\"128\\\",#上海能源交易所(SC等)\\n}\\n\\nPERIOD_MAP={\\n\\\"1min\\\":1,\\\"5min\\\":5,\\\"15min\\\":15,\\\"30min\\\":30,\\n\\\"60min\\\":60,\\\"日线\\\":101,\\\"daily\\\":101,\\n\\\"周线\\\":102,\\\"weekly\\\":102,\\n\\\"月线\\\":103,\\\"monthly\\\":103,\\n}\\n\\nFIELD_NAMES=[\\n\\\"日期\\\",\\\"开盘\\\",\\\"收盘\\\",\\\"最高\\\",\\\"最低\\\",\\n\\\"成交量\\\",\\\"成交额\\\",\\\"振幅%\\\",\\\"涨跌幅%\\\",\\\"涨跌额\\\",\\\"换手率%\\\"\\n]\\n\\nAPI_URL=\\\"https://push2his.eastmoney.com/api/qt/stock/kline/get\\\"\\n\\n\\n#════════════════════════════════════════════\\n#核心函数\\n#════════════════════════════════════════════\\n\\ndefauto_detect_secid(symbol):\\n\\\"\\\"\\\"根据代码自动识别市场并构造secid\\\"\\\"\\\"\\nsymbol=symbol.strip().upper()\\n\\n#期货:第一个字符是字母(M2509,RB2510,IF2506,AG2508等)\\nifsymbol[0].isalpha():\\n#中金所品种:IF,IC,IH,IM,TS,TF,T,TL\\ncffex_codes=[\\\"IF\\\",\\\"IC\\\",\\\"IH\\\",\\\"IM\\\",\\\"TS\\\",\\\"TF\\\",\\\"TL\\\"]\\ncode_prefix=symbol[:2]iflen(symbol)>=2elsesymbol\\nifcode_prefixincffex_codes:\\nreturnf\\\"{MARKET_PREFIX['futures_cffex']}.{symbol}\\\"\\n#上期所/能源所\\nshfe_codes=[\\\"AU\\\",\\\"AG\\\",\\\"CU\\\",\\\"AL\\\",\\\"ZN\\\",\\\"PB\\\",\\\"NI\\\",\\\"SN\\\",\\\"SS\\\",\\\"RB\\\",\\\"HC\\\",\\\"BU\\\",\\\"RU\\\",\\\"SP\\\",\\\"FU\\\",\\\"WR\\\"]\\nifcode_prefixinshfe_codes:\\nreturnf\\\"{MARKET_PREFIX['futures_shfe']}.{symbol}\\\"\\nifcode_prefix==\\\"SC\\\"orcode_prefix==\\\"LU\\\"orcode_prefix==\\\"BC\\\"orcode_prefix==\\\"NR\\\":\\nreturnf\\\"{MARKET_PREFIX['futures_ine']}.{symbol}\\\"\\n#默认大商所/郑商所\\nreturnf\\\"{MARKET_PREFIX['futures']}.{symbol}\\\"\\n\\n#股票:纯数字\\nifsymbol.startswith((\\\"000\\\",\\\"001\\\",\\\"002\\\",\\\"003\\\",\\\"300\\\",\\\"301\\\")):\\nreturnf\\\"{MARKET_PREFIX['sz']}.{symbol}\\\"\\nifsymbol.startswith(\\\"8\\\"):\\nreturnf\\\"{MARKET_PREFIX['bj']}.{symbol}\\\"\\n#上证:600/601/603/605/688\\nreturnf\\\"{MARKET_PREFIX['sh']}.{symbol}\\\"\\n\\n\\ndeffetch_kline(secid,period=101,limit=60,end_date=\\\"20500000\\\"):\\n\\\"\\\"\\\"\\n从东方财富获取K线数据\\n\\n返回:{\\\"success\\\":bool,\\\"name\\\":str,\\\"code\\\":str,\\\"data\\\":list[dict],\\\"error\\\":str}\\n\\\"\\\"\\\"\\nparams=f\\\"secid={secid}&klt={period}&fqt=0&end={end_date}&lmt={limit}\\\"\\nurl=f\\\"{API_URL}?{params}\\\"\\n\\ntry:\\nreq=urllib.request.Request(url,headers={\\n\\\"User-Agent\\\":\\\"Mozilla/5.0(WindowsNT10.0;Win64;x64)\\\",\\n\\\"Referer\\\":\\\"https://quote.eastmoney.com/\\\"\\n})\\nwithurllib.request.urlopen(req,timeout=15)asresp:\\nraw=json.loads(resp.read().decode('utf-8'))\\n\\nifraw.get(\\\"rc\\\")!=0:\\nreturn{\\\"success\\\":False,\\\"error\\\":f\\\"API返回错误码rc={raw.get('rc')}\\\"}\\n\\nd=raw.get(\\\"data\\\")\\nifnotdornotd.get(\\\"klines\\\"):\\nreturn{\\\"success\\\":False,\\\"error\\\":\\\"返回数据为空\\\"}\\n\\nrows=[]\\nforlineind[\\\"klines\\\"]:\\nparts=line.split(\\\",\\\")\\nrow={}\\nfori,valinenumerate(parts):\\nkey=FIELD_NAMES[i]ifi<len(FIELD_NAMES)elsef\\\"字段{i}\\\"\\n#尝试数字转换(除日期外)\\nifi>0:\\ntry:\\nval_num=float(val)if'.'invalelseint(val)\\nrow[key]=val_num\\nexceptValueError:\\nrow[key]=val\\nelse:\\nrow[key]=val\\nrows.append(row)\\n\\nreturn{\\n\\\"success\\\":True,\\n\\\"name\\\":d.get(\\\"name\\\",\\\"\\\"),\\n\\\"code\\\":d.get(\\\"code\\\",\\\"\\\"),\\n\\\"market\\\":d.get(\\\"market\\\",\\\"\\\"),\\n\\\"data\\\":rows\\n}\\nexcepturllib.error.HTTPErrorase:\\nreturn{\\\"success\\\":False,\\\"error\\\":f\\\"HTTP错误{e.code}\\\"}\\nexceptExceptionase:\\nreturn{\\\"success\\\":False,\\\"error\\\":str(e)}\\n\\n\\ndefformat_table(result,limit=20):\\n\\\"\\\"\\\"格式化输出为可读表格\\\"\\\"\\\"\\nifnotresult[\\\"success\\\"]:\\nreturnf\\\"❌错误:{result['error']}\\\"\\n\\nlines=[]\\nlines.append(\\\"╔\\\"+\\\"═\\\"*68+\\\"╗\\\")\\nlines.append(f\\\"║{result['name']}({result['code']})-{result.get('market','')}║\\\".center(72)[:72])\\nlines.append(\\\"╠\\\"+\\\"═\\\"*68+\\\"╣\\\")\\nlines.append(f\\\"║{'日期':<10}{'开盘':>8}{'收盘':>8}{'最高':>8}{'最低':>8}{'成交量':>12}{'涨跌幅':>6}║\\\")\\nlines.append(\\\"╟\\\"+\\\"─\\\"*68+\\\"╢\\\")\\n\\ndata=result[\\\"data\\\"]\\nshow=data[:limit]iflimitelsedata\\n\\nforrowinshow:\\ndate=row.get(\\\"日期\\\",\\\"\\\")[:10]#取日期部分\\nopen_p=row.get(\\\"开盘\\\",0)\\nclose=row.get(\\\"收盘\\\",0)\\nhigh=row.get(\\\"最高\\\",0)\\nlow=row.get(\\\"最低\\\",0)\\nvolume=row.get(\\\"成交量\\\",0)\\npct_chg=row.get(\\\"涨跌幅%\\\",0)\\n\\n#格式化成交量(万手)\\nvol_str=f\\\"{volume/10000:.1f}万\\\"ifvolume>=10000elsestr(volume)\\n\\n#涨跌幅颜色标记\\nchg_mark=\\\"\\\"\\nifisinstance(pct_chg,(int,float)):\\nifpct_chg>0:chg_mark=\\\"+\\\"\\nelifpct_chg<0:chg_mark=\\\"\\\"\\n\\nlines.append(\\nf\\\"║{date:<10}{open_p:>8.2f}{close:>8.2f}{high:>8.2f}{low:>8.2f}{vol_str:>12}{chg_mark}{pct_chg:>5.2f}%║\\\"\\n)\\n\\nlines.append(\\\"╚\\\"+\\\"═\\\"*68+\\\"╝\\\")\\niflimitandlen(data)>limit:\\nlines.append(f\\\"...(共{len(data)}条,显示前{limit}条)\\\")\\nlines.append(f\\\"数据范围:{data[-1].get('日期','?')}~{data[0].get('日期','?')}({len(data)}条)\\\")\\n\\nreturn\\\"\\\\n\\\".join(lines)\\n\\n\\ndefformat_summary(result):\\n\\\"\\\"\\\"输出数据摘要统计\\\"\\\"\\\"\\nifnotresult[\\\"success\\\"]:\\nreturn\\\"\\\"\\n\\ndata=result[\\\"data\\\"]\\niflen(data)<2:\\nreturn\\\"\\\"\\n\\nlatest=data[0]\\noldest=data[-1]\\n\\nclose_latest=latest.get(\\\"收盘\\\",0)\\nclose_oldest=oldest.get(\\\"收盘\\\",0)\\nhigh_all=max(r.get(\\\"最高\\\",0)forrindata)\\nlow_all=min(r.get(\\\"最低\\\",0)forrindata)\\n\\nifclose_oldestandclose_oldest!=0:\\ntotal_chg=(close_latest-close_oldest)/close_oldest*100\\nelse:\\ntotal_chg=0\\n\\nlines=[]\\nlines.append(\\\"\\\\n📊数据摘要:\\\")\\nlines.append(f\\\"区间:{oldest.get('日期','?')}→{latest.get('日期','?')}({len(data)}条)\\\")\\nlines.append(f\\\"价格:{low_all:.2f}~{high_all:.2f}\\\")\\nlines.append(f\\\"区间涨跌:{close_oldest:.2f}→{close_latest:.2f}({total_chg:+.2f}%)\\\")\\n\\n#最近5日的简单统计\\nrecent=data[:min(5,len(data))]\\nvol_avg=sum(r.get(\\\"成交量\\\",0)forrinrecent)/len(recent)\\nlines.append(f\\\"近{len(recent)}日均量:{vol_avg/10000:.1f}万手\\\")\\n\\nreturn\\\"\\\\n\\\".join(lines)\\n\\n\\n#════════════════════════════════════════════\\n#命令行入口\\n#════════════════════════════════════════════\\n\\ndefmain():\\nparser=argparse.ArgumentParser(\\ndescription=\\\"东方财富K线通用查询工具\\\",\\nformatter_class=argparse.RawDescriptionHelpFormatter,\\nepilog=\\\"\\\"\\\"\\n示例:\\npython3eastmoney.py600519\\npython3eastmoney.py000858--period60min--limit30\\npython3eastmoney.pyM2509--periodweekly--json\\npython3eastmoney.pyAG2508--marketfutures_shfe\\n\\\"\\\"\\\"\\n)\\nparser.add_argument(\\\"symbol\\\",help=\\\"证券代码(如600519,000858,M2509)\\\")\\nparser.add_argument(\\\"--market\\\",\\\"-m\\\",default=\\\"auto\\\",\\nchoices=[\\\"auto\\\",\\\"sh\\\",\\\"sz\\\",\\\"bj\\\",\\\"futures\\\",\\n\\\"futures_shfe\\\",\\\"futures_cffex\\\",\\\"futures_ine\\\"],\\nhelp=\\\"市场类型(默认:auto自动识别)\\\")\\nparser.add_argument(\\\"--period\\\",\\\"-p\\\",default=\\\"daily\\\",\\nchoices=list(PERIOD_MAP.keys()),\\nhelp=\\\"K线周期(默认:daily日线)\\\")\\nparser.add_argument(\\\"--limit\\\",\\\"-l\\\",type=int,default=60,\\nhelp=\\\"返回条数(默认:60,最大:200)\\\")\\nparser.add_argument(\\\"--json\\\",action=\\\"store_true\\\",help=\\\"输出JSON格式\\\")\\nparser.add_argument(\\\"--csv\\\",action=\\\"store_true\\\",help=\\\"输出CSV格式\\\")\\nparser.add_argument(\\\"--summary\\\",\\\"-s\\\",action=\\\"store_true\\\",help=\\\"仅输出摘要统计\\\")\\n\\nargs=parser.parse_args()\\nlimit=min(args.limit,200)\\n\\n#构建secid\\nifargs.market==\\\"auto\\\":\\nsecid=auto_detect_secid(args.symbol)\\nelse:\\nprefix=MARKET_PREFIX[args.market]\\nsecid=f\\\"{prefix}.{args.symbol.upper()}\\\"\\n\\n#获取数据\\nperiod_val=PERIOD_MAP[args.period]\\nresult=fetch_kline(secid,period_val,limit)\\nresult[\\\"secid\\\"]=secid\\nresult[\\\"period_name\\\"]=args.period\\n\\n#输出\\nifargs.json:\\nprint(json.dumps(result,ensure_ascii=False,indent=2))\\nelifargs.csv:\\nifnotresult[\\\"success\\\"]:\\nprint(f\\\"#Error:{result['error']}\\\")\\nsys.exit(1)\\nimportcsv\\nimportio\\noutput=io.StringIO()\\nwriter=csv.DictWriter(output,fieldnames=FIELD_NAMES,extrasaction='ignore')\\nwriter.writeheader()\\nforrowinresult[\\\"data\\\"]:\\nwriter.writerow(row)\\nprint(output.getvalue(),end=\\\"\\\")\\nelifargs.summary:\\nprint(format_summary(result))\\nelse:\\nprint(format_table(result,limit=20))\\nprint(format_summary(result))\\n\\n\\nif__name__==\\\"__main__\\\":\\nmain()\\n'''\\n\\n#创建目录并写入脚本\\nos.makedirs(os.path.join(SKILL_DIR,\\\"scripts\\\"),exist_ok=True)\\nwithopen(SCRIPT_PATH,'w',encoding='utf-8')asf:\\nf.write(script_code)\\nos.chmod(SCRIPT_PATH,0o755)\\nprint(f\\\"\\\\n✅脚本已保存:{SCRIPT_PATH}\\\")\\nprint(f\\\"大小:{len(script_code)}字节\\\")\\n\\n#============STEP3:测试脚本============\\nprint(\\\"\\\\n\\\"+\\\"=\\\"*70)\\nprint(\\\"STEP3:测试脚本(多个标的)\\\")\\nprint(\\\"=\\\"*70)\\n\\n#写一个临时测试脚本来测试刚创建的模块\\nos.chdir(os.path.dirname(SCRIPT_PATH))\\n\\n#直接导入测试\\nsys.path.insert(0,os.path.dirname(SCRIPT_PATH))\\nimportimportlib.util\\nspec=importlib.util.spec_from_file_location(\\\"eastmoney\\\",SCRIPT_PATH)\\nem=importlib.util.module_from_spec(spec)\\nspec.loader.exec_module(em)\\n\\ntest_results=[]\\ntest_cases=[\\n(\\\"600519\\\",\\\"sh\\\",\\\"日线\\\",\\\"茅台(上证日线)\\\"),\\n(\\\"000858\\\",\\\"sz\\\",\\\"日线\\\",\\\"五粮液(深证日线)\\\"),\\n(\\\"M2509\\\",\\\"futures\\\",\\\"60min\\\",\\\"豆粕期货60分钟\\\"),\\n(\\\"600519\\\",\\\"sh\\\",\\\"周线\\\",\\\"茅台(上证周线)\\\"),\\n(\\\"AG2508\\\",\\\"futures_shfe\\\",\\\"日线\\\",\\\"白银期货(上期所)\\\"),\\n]\\n\\nforsymbol,market,period,descintest_cases:\\nsecid=em.auto_detect_secid(symbol)ifmarket==\\\"auto\\\"elsef\\\"{em.MARKET_PREFIX[market]}.{symbol.upper()}\\\"\\nperiod_val=em.PERIOD_MAP[period]\\nresult=em.fetch_kline(secid,period_val,limit=3)\\nstatus=\\\"✅\\\"ifresult[\\\"success\\\"]else\\\"❌\\\"\\nname=result.get(\\\"name\\\",\\\"?\\\")\\ndata_count=len(result.get(\\\"data\\\",[]))\\ntest_results.append((desc,status,name,data_count,result.get(\\\"error\\\",\\\"\\\")))\\nprint(f\\\"{status}[{desc}]{name}secid={secid}period={period}({period_val})data={data_count}条\\\")\\nifresult[\\\"success\\\"]andresult[\\\"data\\\"]:\\nr=result[\\\"data\\\"][0]\\nprint(f\\\"最新:{r.get('日期','?')[:10]}开={r.get('开盘','?')}收={r.get('收盘','?')}高={r.get('最高','?')}低={r.get('最低','?')}\\\")\\n\\n#测试表格输出\\nprint(\\\"\\\\n---表格输出测试(茅台日线前5条)---\\\")\\nsecid_maotai=em.auto_detect_secid(\\\"600519\\\")\\nresult_maotai=em.fetch_kline(secid_maotai,101,limit=5)\\nifresult_maotai[\\\"success\\\"]:\\ntable_output=em.format_table(result_maotai,limit=5)\\nsum_output=em.format_summary(result_maotai)\\nprint(table_output)\\nprint(sum_output)\\n\\nprint(\\\"\\\\n✅全部测试完成\\\")\\n\\n#============STEP4:创建SKILL.md============\\nprint(\\\"\\\\n\\\"+\\\"=\\\"*70)\\nprint(\\\"STEP4:创建SKILL.md\\\")\\nprint(\\\"=\\\"*70)\\n\\nskill_md=f'''---\\nname:eastmoney-kline\\ndescription:东方财富K线通用查询工具—支持期货和股票的多周期K线数据获取,自动识别市场,多种输出格式\\nversion:1.0.0\\nmetadata:\\nhermes:\\ntags:[finance,kline,eastmoney,stock,futures,data]\\nrelated_skills:[]\\n---\\n\\n#EastMoneyKlineFetcher\\n\\n##概述\\n\\n从东方财富API获取期货和股票的K线数据。自动识别市场(上证/深证/期货/北交所),支持多周期(1分钟~月线),输出格式有可读表格/JSON/CSV。\\n\\n##快速使用\\n\\n```bash\\n#基本查询\\npython3{SCRIPT_PATH}600519\\n\\n#指定周期和条数\\npython3{SCRIPT_PATH}M2509--period60min--limit30\\n\\n#JSON输出(便于程序处理)\\npython3{SCRIPT_PATH}000858--json\\n\\n#仅看摘要统计\\npython3{SCRIPT_PATH}600519--summary\\n\\n#CSV输出\\npython3{SCRIPT_PATH}M2509--csv\\n\\n#手动指定市场\\npython3{SCRIPT_PATH}AG2508--marketfutures_shfe\\n```\\n\\n##参数说明\\n\\n|参数|说明|示例|\\n|------|------|------|\\n|`symbol`|证券代码(必填)|`600519`,`000858`,`M2509`|\\n|`--market/-m`|市场类型,`auto`自动识别|`sh`,`sz`,`futures`,`futures_shfe`|\\n|`--period/-p`|K线周期,默认`daily`|`1min`,`60min`,`daily`,`weekly`,`monthly`|\\n|`--limit/-l`|返回条数,默认60,最大200|`--limit30`|\\n|`--json`|JSON格式输出||\\n|`--csv`|CSV格式输出||\\n|`--summary/-s`|仅输出摘要统计||\\n\\n##市场映射\\n\\n|市场|前缀|品种示例|\\n|------|------|---------|\\n|上证|`1.`|600519,601318,688981|\\n|深证|`0.`|000858,002415,300750|\\n|北交所|`0.`|8xxxxx系列|\\n|大商所/郑商所|`114.`|M2509,RB2510,FG2601,MA2605|\\n|上期所|`113.`|AU2508,AG2508,CU2507|\\n|中金所|`8.`|IF2506,IC2506,IM2506|\\n|能源所|`128.`|SC2507,LU2508|\\n\\n##K线周期映射\\n\\n|名称|klt值|\\n|------|------|\\n|1分钟|1|\\n|5分钟|5|\\n|15分钟|15|\\n|30分钟|30|\\n|60分钟|60|\\n|日线|101|\\n|周线|102|\\n|月线|103|\\n\\n##在Hermes中使用\\n\\n```python\\nimportsys\\nsys.path.insert(0,\\\"{os.path.dirname(SCRIPT_PATH)}\\\")\\nfromeastmoneyimportfetch_kline,format_table,format_summary,auto_detect_secid\\n\\n#获取数据\\nresult=fetch_kline(\\\"1.600519\\\",period=101,limit=20)\\nifresult[\\\"success\\\"]:\\nprint(format_table(result))\\nprint(format_summary(result))\\nelse:\\nprint(f\\\"Error:{{result['error']}}\\\")\\n```\\n\\n##输出示例\\n\\n```\\n╔════════════════════════════════════════════════════════════════════╗\\n║贵州茅台(600519)-1║\\n╠════════════════════════════════════════════════════════════════════╣\\n║日期开盘收盘最高最低成交量涨跌幅║\\n╟────────────────────────────────────────────────────────────────────╢\\n║2026-05-131620.001635.501642.001615.003.2万+0.96%║\\n║2026-05-121610.001620.001628.001605.002.8万+0.62%║\\n║...\\n╚════════════════════════════════════════════════════════════════════╝\\n\\n📊数据摘要:\\n区间:2026-02-17→2026-05-13(60条)\\n价格:1580.00~1720.00\\n区间涨跌:1585.00→1635.50(+3.19%)\\n近5日均量:3.1万手\\n```\\n\\n##API信息\\n\\n-**端点**:`https://push2his.eastmoney.com/api/qt/stock/kline/get`\\n-**关键参数**:`secid`,`klt`,`fqt`,`end`,`lmt`\\n-**返回格式**:JSON,`klines`字段为CSV字符串数组\\n-**字段顺序**:日期,开盘,收盘,最高,最低,成交量,成交额,振幅%,涨跌幅%,涨跌额,换手率%\\n\\n##文件结构\\n\\n```\\n{SKILL_DIR}/\\n├──SKILL.md#本文件\\n└──scripts/\\n└──eastmoney.py#主脚本\\n```\\n\\n##注意事项\\n\\n-成交量单位为手(股票)或手(期货)\\n-期货价格单位与交易所一致(如白银为元/千克)\\n-API有请求频率限制,建议间隔≥0.5秒\\n-数据延迟约15分钟(非实时)\\n-`end=20500000`表示获取到最新数据\\n'''\\n\\nskill_md_path=os.path.join(SKILL_DIR,\\\"SKILL.md\\\")\\nwithopen(skill_md_path,'w',encoding='utf-8')asf:\\nf.write(skill_md)\\nprint(f\\\"✅SKILL.md已保存:{skill_md_path}\\\")\\nprint(f\\\"大小:{len(skill_md)}字节\\\")\\n\\n#============STEP5:注册到Hermes============\\nprint(\\\"\\\\n\\\"+\\\"=\\\"*70)\\nprint(\\\"STEP5:验证并输出总结\\\")\\nprint(\\\"=\\\"*70)\\n\\n#验证文件存在\\nfiles_ok=all(os.path.exists(p)forpin[SCRIPT_PATH,skill_md_path])\\nprint(f\\\"\\\\n📁文件验证:{'✅全部就绪'iffiles_okelse'❌有缺失'}\\\")\\nprint(f\\\"脚本:{SCRIPT_PATH}\\\")\\nprint(f\\\"文档:{skill_md_path}\\\")\\n\\n#测试计数\\npassed=sum(1for_,s,_,_,_intest_resultsif\\\"✅\\\"ins)\\nfailed=len(test_results)-passed\\nprint(f\\\"\\\\n📊测试结果:{passed}/{len(test_results)}通过\\\")\\niffailed:\\nfordesc,status,name,count,errintest_results:\\nif\\\"❌\\\"instatus:\\nprint(f\\\"❌{desc}:{err}\\\")\\n\\n#输出完整路径供用户直接使用\\nprint(f\\\"\\\\n🎯完成!使用方法:\\\")\\nprint(f\\\"python3{SCRIPT_PATH}600519\\\")\\nprint(f\\\"python3{SCRIPT_PATH}M2509--period60min\\\")\\nprint(f\\\"python3{SCRIPT_PATH}AG2508--marketfutures_shfe\\\")\\n\"})\n[User]: 整了个寂寞", "sessionId": 658084, "files": [], "temperature": 0.7, "top_p": 1.0, "presence_penalty": 0, "frequency_penalty": 0}}
