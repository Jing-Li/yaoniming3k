{"timestamp": "2026-05-14T02:09:28.004753+00:00", "level": "DEBUG", "logger": "provider_response", "message": "Taiji API response (streaming)", "request_id": "eba0069a-5c4f-4c04-83c8-62be2654f62e", "latency_ms": 6092.05, "total_content_length": 173, "total_reasoning_length": 288, "has_tools": true, "parsed_tool_calls_count": 1, "total_content_preview": "<tool_calls><invokename=\"terminal\"><parametername=\"command\">curl-s\"wttr.in/beijing?format=%l:+%c+%t\"</parameter><parametername=\"timeout\">10</parameter></invoke></tool_calls>", "total_reasoning_preview": "We need to re-run the command correctly. There's a missing space between curl and -s. Let's fix.\n\nAlso we can just call curl -s \"wttr.in/beijing?format=%l:+%c+%t\" (with quotes). But the error shows it tried to execute curl-swttr.in... so the space after curl was missing. Let's run again.", "content_buffer_size": 63, "tool_call_detected": true}
{"timestamp": "2026-05-14T02:09:28.004857+00:00", "level": "DEBUG", "logger": "raw_response", "message": "Outgoing response (streaming)", "request_id": "eba0069a-5c4f-4c04-83c8-62be2654f62e", "total_chunks": 84, "chunks_preview": ["{\"id\":\"chatcmpl-2d30bb22dc8e\",\"object\":\"chat.completion.chunk\",\"created\":1778724561,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"reasoning_content\":\" We\"}}]}", "{\"id\":\"chatcmpl-2d30bb22dc8e\",\"object\":\"chat.completion.chunk\",\"created\":1778724561,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" need\"}}]}", "{\"id\":\"chatcmpl-2d30bb22dc8e\",\"object\":\"chat.completion.chunk\",\"created\":1778724561,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" to\"}}]}", "{\"id\":\"chatcmpl-2d30bb22dc8e\",\"object\":\"chat.completion.chunk\",\"created\":1778724561,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\" re\"}}]}", "{\"id\":\"chatcmpl-2d30bb22dc8e\",\"object\":\"chat.completion.chunk\",\"created\":1778724561,\"model\":\"taiji\",\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"-run\"}}]}"]}
